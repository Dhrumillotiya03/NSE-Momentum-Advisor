# Bulk market data — re-downloadable, would bloat every diff (100M+)
data/price_data/
data/delivery_data/
data/fo_data/
data/etf_data/

# Daily pipeline run log — append-only output of run_daily_log.sh
data/cron_daily_log.log

# Backfill resume-progress logs — regenerated, not meaningful history
data/bhavcopy_backfill_progress.txt
data/fo_backfill_progress.txt

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/

# Exported codebase dump (regenerated, huge)
complete_codebase.txt

# Local editor/tooling
.vscode/
.idea/
*.swp

# NOTE: small trusted-source + state files ARE tracked on purpose:
#   data/sectors.json, config.yaml, data/*.json state, data/sr_*.csv,
#   data/index_data/, nifty universe CSVs — these are curated/small and
#   you want their history across sessions.
